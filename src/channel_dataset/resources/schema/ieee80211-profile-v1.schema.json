{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channel-dataset.invalid/schema/ieee80211-profile-v1.schema.json",
  "title": "IEEE 802.11 TGn A-F transcribed profile",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "name", "delays_ns", "rms_delay_spread_ns", "breakpoint_distance_m", "shadow_std_los_db", "shadow_std_nlos_db", "los_k_factor_db", "clusters", "metadata"],
  "properties": {
    "schema_version": {"const": 1}, "name": {"enum": ["A", "B", "C", "D", "E", "F"]},
    "delays_ns": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
    "rms_delay_spread_ns": {"type": "number", "minimum": 0}, "breakpoint_distance_m": {"type": "number", "exclusiveMinimum": 0},
    "shadow_std_los_db": {"type": "number", "minimum": 0}, "shadow_std_nlos_db": {"type": "number", "minimum": 0}, "los_k_factor_db": {"type": "number"},
    "clusters": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "tap_indices", "powers_db", "aoa_deg", "aod_deg", "rx_as_deg", "tx_as_deg"], "properties": {"id": {"type": "integer", "minimum": 1}, "tap_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}, "powers_db": {"type": "array", "minItems": 1, "items": {"type": "number"}}, "aoa_deg": {"type": "number"}, "aod_deg": {"type": "number"}, "rx_as_deg": {"type": "number", "exclusiveMinimum": 0}, "tx_as_deg": {"type": "number", "exclusiveMinimum": 0}}}},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["source_document", "source_revision", "source_table", "source_url", "units_reviewed", "review_status", "checksum"], "properties": {"source_document": {"type": "string"}, "source_revision": {"type": "string"}, "source_table": {"type": "string"}, "source_url": {"type": "string"}, "units_reviewed": {"const": true}, "review_status": {"enum": ["pending_independent_review", "independently_reviewed"]}, "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
