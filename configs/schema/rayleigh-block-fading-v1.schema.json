{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/channel-dataset/rayleigh-block-fading-v1.schema.json",
  "title": "Rayleigh block-fading model parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "num_rx",
    "num_rx_antennas",
    "num_tx",
    "num_tx_antennas",
    "average_power_linear"
  ],
  "properties": {
    "num_rx": {"type": "integer", "minimum": 1},
    "num_rx_antennas": {"type": "integer", "minimum": 1},
    "num_tx": {"type": "integer", "minimum": 1},
    "num_tx_antennas": {"type": "integer", "minimum": 1},
    "average_power_linear": {"type": "number", "exclusiveMinimum": 0}
  }
}
