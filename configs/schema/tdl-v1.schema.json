{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channel-dataset.invalid/schema/tdl-v1.schema.json",
  "title": "3GPP TDL model parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile", "standard_version", "delay_spread_s", "carrier_frequency_hz",
    "bandwidth_hz", "speed_mps", "num_rx", "num_rx_antennas", "num_tx",
    "num_tx_antennas", "num_sinusoids", "k_factor_db", "correlation_mode",
    "rx_correlation_coefficient", "tx_correlation_coefficient",
    "joint_correlation_matrix"
  ],
  "properties": {
    "profile": {"enum": ["TDL-A", "TDL-B", "TDL-C", "TDL-D", "TDL-E", "TDLA30", "TDLB100", "TDLC300", "TDLC60"]},
    "standard_version": {"const": "16.1.0"},
    "delay_spread_s": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "carrier_frequency_hz": {"type": "number", "exclusiveMinimum": 0},
    "bandwidth_hz": {"type": "number", "exclusiveMinimum": 0},
    "speed_mps": {"type": "number", "minimum": 0},
    "num_rx": {"type": "integer", "minimum": 1},
    "num_rx_antennas": {"type": "integer", "minimum": 1},
    "num_tx": {"type": "integer", "minimum": 1},
    "num_tx_antennas": {"type": "integer", "minimum": 1},
    "num_sinusoids": {"type": "integer", "minimum": 1},
    "k_factor_db": {"type": ["number", "null"]},
    "correlation_mode": {"enum": ["none", "kronecker", "joint"]},
    "rx_correlation_coefficient": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
    "tx_correlation_coefficient": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
    "joint_correlation_matrix": {
      "type": ["array", "null"],
      "items": {"type": "array", "items": {"type": "number"}}
    }
  }
}
